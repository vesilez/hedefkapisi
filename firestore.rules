rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function roleIs(role) {
      return signedIn() && currentUser().data.role == role;
    }

    function isAdmin() {
      return roleIs("admin") || roleIs("superadmin");
    }

    function isSuperAdmin() {
      return roleIs("superadmin");
    }

    function validTimestamp(value) {
      return value is timestamp && value <= request.time;
    }

    function safeUserText(value, minimum, maximum) {
      return value is string
        && value.size() >= minimum
        && value.size() <= maximum
        && !value.matches(".*<.*");
    }

    function validOptionalText(value, maximum) {
      return value == null
        || (value is string
          && value.size() <= maximum
          && !value.matches(".*<.*"));
    }

    function validOptionalWebUrl(value) {
      return value == null
        || (value is string
          && value.size() <= 2048
          && value.matches("^https?://.*"));
    }

    function validAchievement(value) {
      return value is map
        && value.keys().hasOnly(["unlocked", "unlockedAt"])
        && value.unlocked == true
        && validTimestamp(value.unlockedAt);
    }

    function validAchievements(data) {
      let achievements = data.get("achievements", {});
      return achievements is map
        && achievements.keys().hasOnly([
          "first_dream",
          "first_like",
          "first_support",
          "first_chat",
          "sponsor_badge"
        ])
        && (!("first_dream" in achievements) || validAchievement(achievements.first_dream))
        && (!("first_like" in achievements) || validAchievement(achievements.first_like))
        && (!("first_support" in achievements) || validAchievement(achievements.first_support))
        && (!("first_chat" in achievements) || validAchievement(achievements.first_chat))
        && (!("sponsor_badge" in achievements) || validAchievement(achievements.sponsor_badge));
    }

    function achievementCount(data) {
      let achievements = data.get("achievements", {});
      return (("first_dream" in achievements) ? 1 : 0)
        + (("first_like" in achievements) ? 1 : 0)
        + (("first_support" in achievements) ? 1 : 0)
        + (("first_chat" in achievements) ? 1 : 0)
        + (("sponsor_badge" in achievements) ? 1 : 0);
    }

    function validAchievementGrowth() {
      let before = resource.data.get("achievements", {});
      let after = request.resource.data.get("achievements", {});
      return validAchievements(request.resource.data)
        && after.keys().hasAll(before.keys())
        && after.diff(before).removedKeys().size() == 0;
    }

    function validAchievementBackfill() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["achievements"])
        && validAchievementGrowth();
    }

    match /users/{userId} {
      function validEditableProfileFields() {
        return safeUserText(request.resource.data.name, 2, 50)
          && safeUserText(request.resource.data.surname, 2, 50)
          && safeUserText(request.resource.data.city, 2, 100)
          && validOptionalText(request.resource.data.get("phone", null), 30)
          && validOptionalWebUrl(request.resource.data.get("avatarUrl", null));
      }

      function validRegistrationSponsorProfile() {
        let profile = request.resource.data.get("sponsorProfile", null);
        return (
          request.resource.data.role == "sponsor"
          && profile is map
          && profile.keys().hasOnly([
            "organizationName", "organizationType", "city", "website",
            "description", "supportAreas", "approvalStatus"
          ])
          && safeUserText(profile.organizationName, 2, 120)
          && profile.organizationType in [
            "company", "ngo", "foundation", "public_institution",
            "university", "other"
          ]
          && safeUserText(profile.city, 2, 80)
          && profile.description is string
          && profile.description.size() >= 20
          && profile.description.size() <= 1500
          && profile.supportAreas is list
          && profile.supportAreas.size() >= 1
          && profile.supportAreas.size() <= 12
          && profile.approvalStatus == "pending"
        ) || (
          request.resource.data.role != "sponsor"
          && !("sponsorProfile" in request.resource.data)
        );
      }

      function validScoreUpdate() {
        let eventId = request.resource.data.lastScoreEventId;
        let eventPath = /databases/$(database)/documents/scoreEvents/$(eventId);
        let eventExisted = exists(eventPath);
        let eventExistsAfter = existsAfter(eventPath);
        let event = eventExistsAfter ? getAfter(eventPath).data : get(eventPath).data;
        let beforeAchievements = resource.data.get("achievements", {});
        let afterAchievements = request.resource.data.get("achievements", {});
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["score", "lastScoreEventId", "achievements"])
          && (
            afterAchievements == beforeAchievements
            || (
              validAchievementGrowth()
              && (
                (event.type == "dream"
                  && afterAchievements.diff(beforeAchievements).affectedKeys()
                    .hasOnly(["first_dream"]))
                || (event.type == "completed_support"
                  && afterAchievements.diff(beforeAchievements).affectedKeys()
                    .hasOnly(["first_support"]))
              )
            )
          )
          && event.userId == userId
          && (
            (
              !eventExisted
              && eventExistsAfter
              && request.resource.data.score == resource.data.get("score", 0) + event.points
            )
            || (
              eventExisted
              && !eventExistsAfter
              && event.type == "like"
              && request.resource.data.score == resource.data.get("score", 0) - 2
            )
          )
          && request.resource.data.score >= 0;
      }

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.uid == userId
        && request.resource.data.role in ["student", "supporter", "mentor", "sponsor"]
        && request.resource.data.status == "active"
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailVerified == request.auth.token.email_verified
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.score == 0
        && request.resource.data.lastScoreEventId == null
        && request.resource.data.profileCompleted == false
        && validRegistrationSponsorProfile()
        && request.resource.data.keys().hasOnly([
          "id", "uid", "role", "name", "surname", "email", "phone", "city",
          "status", "profileCompleted", "emailVerified", "avatarUrl",
          "score", "lastScoreEventId", "sponsorProfile", "createdAt", "updatedAt"
        ]);

      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow update: if signedIn() && (
        (
          request.auth.uid == userId
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "name", "surname", "phone", "city", "profileCompleted",
                "avatarUrl", "studentProfile", "supporterProfile",
                "mentorProfile", "updatedAt"
              ])
              && request.resource.data.id == resource.data.id
              && request.resource.data.role == resource.data.role
              && request.resource.data.status == resource.data.status
              && request.resource.data.email == resource.data.email
              && request.resource.data.emailVerified == resource.data.emailVerified
              && request.resource.data.get("achievements", {}) == resource.data.get("achievements", {})
              && request.resource.data.get("score", 0) == resource.data.get("score", 0)
              && request.resource.data.get("lastScoreEventId", null) == resource.data.get("lastScoreEventId", null)
              && validEditableProfileFields()
            )
            || validAchievementBackfill()
            || validScoreUpdate()
          )
        )
        || (
          isAdmin()
          && request.auth.uid != userId
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["role", "status", "updatedAt"])
              && (isSuperAdmin() || (
                resource.data.role != "superadmin"
                && request.resource.data.role != "superadmin"
              ))
            )
            || validAchievementBackfill()
          )
        )
      );

      allow delete: if isSuperAdmin() && request.auth.uid != userId;
    }

    match /scoreEvents/{eventId} {
      function validEvent() {
        let type = request.resource.data.type;
        let sourceId = request.resource.data.sourceId;
        let userId = request.resource.data.userId;
        return request.resource.data.id == eventId
          && eventId == type + "__" + sourceId
          && request.resource.data.createdAt == request.time
          && (
            (
              type == "dream"
              && request.resource.data.points == 20
              && getAfter(/databases/$(database)/documents/ideas/$(sourceId)).data.studentId == userId
              && getAfter(/databases/$(database)/documents/ideas/$(sourceId)).data.status != "draft"
            )
            || (
              type == "support"
              && request.resource.data.points == 15
              && getAfter(/databases/$(database)/documents/supportRequests/$(sourceId)).data.supporterId == userId
            )
            || (
              type == "comment"
              && request.resource.data.points == 5
              && getAfter(/databases/$(database)/documents/comments/$(sourceId)).data.userId == userId
              && getAfter(/databases/$(database)/documents/comments/$(sourceId)).data.status == "active"
            )
            || (
              type == "like"
              && request.resource.data.points == 2
              && getAfter(/databases/$(database)/documents/ideas/$(getAfter(/databases/$(database)/documents/likes/$(sourceId)).data.ideaId)).data.studentId == userId
            )
            || (
              type == "completed_support"
              && request.resource.data.points == 30
              && getAfter(/databases/$(database)/documents/supportRequests/$(sourceId)).data.supporterId == userId
              && getAfter(/databases/$(database)/documents/supportRequests/$(sourceId)).data.status == "approved"
            )
            || (
              type == "sponsor_support"
              && request.resource.data.points == 25
              && getAfter(/databases/$(database)/documents/sponsorSupports/$(sourceId)).data.sponsorId == userId
            )
          );
      }

      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "id", "type", "sourceId", "userId", "points", "createdAt"
        ])
        && validEvent();
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.type == "like"
        && get(/databases/$(database)/documents/likes/$(resource.data.sourceId)).data.userId == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/likes/$(resource.data.sourceId));
    }

    match /leaderboard/{userId} {
      function publicUserData() {
        return getAfter(/databases/$(database)/documents/users/$(userId)).data;
      }

      function validProjection() {
        let user = publicUserData();
        return request.resource.data.keys().hasOnly([
            "userId", "name", "surname", "avatarUrl", "role", "score",
            "achievementCount", "updatedAt"
          ])
          && request.resource.data.userId == userId
          && request.resource.data.name == user.name
          && request.resource.data.surname == user.surname
          && request.resource.data.avatarUrl == user.get("avatarUrl", null)
          && request.resource.data.role == user.role
          && request.resource.data.score == user.get("score", 0)
          && request.resource.data.achievementCount == achievementCount(user)
          && request.resource.data.updatedAt == request.time;
      }

      allow read: if true;
      allow create: if signedIn() && validProjection();
      allow update: if signedIn() && validProjection();
      allow delete: if false;
    }

    match /mentorProfiles/{mentorId} {
      function mentorUser() {
        return get(/databases/$(database)/documents/users/$(mentorId));
      }

      function validMentorProfile() {
        let user = mentorUser().data;
        return request.resource.data.keys().hasOnly([
            "mentorId", "name", "surname", "avatarUrl", "city",
            "profession", "organization", "expertiseAreas",
            "mentoringTopics", "availability", "biography", "status",
            "updatedAt"
          ])
          && request.resource.data.mentorId == mentorId
          && user.role == "mentor"
          && request.resource.data.name == user.name
          && request.resource.data.surname == user.surname
          && request.resource.data.avatarUrl == user.get("avatarUrl", null)
          && request.resource.data.city == user.get("city", null)
          && request.resource.data.profession is string
          && request.resource.data.profession.size() <= 120
          && request.resource.data.organization is string
          && request.resource.data.organization.size() <= 160
          && request.resource.data.expertiseAreas is list
          && request.resource.data.expertiseAreas.size() <= 12
          && request.resource.data.mentoringTopics is list
          && request.resource.data.mentoringTopics.size() <= 12
          && request.resource.data.availability is string
          && request.resource.data.biography is string
          && request.resource.data.biography.size() <= 2000
          && request.resource.data.status == "active"
          && request.resource.data.updatedAt == request.time;
      }

      allow read: if resource.data.status == "active" || isAdmin();
      allow create, update: if signedIn()
        && request.auth.uid == mentorId
        && validMentorProfile();
      allow delete: if isAdmin();
    }

    match /mentorships/{mentorshipId} {
      function mentorshipParticipant() {
        return signedIn()
          && request.auth.uid in [resource.data.studentId, resource.data.mentorId];
      }

      allow create: if signedIn()
        && roleIs("student")
        && request.resource.data.keys().hasOnly([
          "id", "studentId", "mentorId", "studentName", "mentorName",
          "message", "focusAreas", "status", "chatId", "respondedAt",
          "completedAt", "createdAt", "updatedAt"
        ])
        && request.resource.data.id == mentorshipId
        && request.resource.data.studentId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.resource.data.mentorId)).data.role == "mentor"
        && exists(/databases/$(database)/documents/mentorProfiles/$(request.resource.data.mentorId))
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 20
        && request.resource.data.message.size() <= 1500
        && safeUserText(request.resource.data.message, 20, 1500)
        && request.resource.data.focusAreas is list
        && request.resource.data.focusAreas.size() >= 1
        && request.resource.data.focusAreas.size() <= 5
        && request.resource.data.status == "pending"
        && request.resource.data.chatId == null
        && request.resource.data.respondedAt == null
        && request.resource.data.completedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if mentorshipParticipant() || isAdmin();
      allow update: if signedIn() && (
        (
          resource.data.mentorId == request.auth.uid
          && (
            (
              resource.data.status == "pending"
              && request.resource.data.status in ["active", "rejected"]
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["status", "chatId", "respondedAt", "updatedAt"])
              && request.resource.data.respondedAt == request.time
              && request.resource.data.updatedAt == request.time
              && (
                (request.resource.data.status == "active"
                  && request.resource.data.chatId == "mentorship__" + mentorshipId)
                || (request.resource.data.status == "rejected"
                  && request.resource.data.chatId == null)
              )
            )
            || (
              resource.data.status == "active"
              && request.resource.data.status == "completed"
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["status", "completedAt", "updatedAt"])
              && request.resource.data.completedAt == request.time
              && request.resource.data.updatedAt == request.time
            )
          )
        )
        || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              "status", "chatId", "respondedAt", "completedAt", "updatedAt"
            ])
          && request.resource.data.status in ["active", "completed", "cancelled"]
          && request.resource.data.updatedAt == request.time
          && (
            request.resource.data.status != "active"
            || (
              request.resource.data.chatId == "mentorship__" + mentorshipId
              && request.resource.data.respondedAt == request.time
            )
          )
        )
      );
      allow delete: if false;
    }

    match /mentorNotes/{noteId} {
      allow read: if signedIn()
        && (resource.data.mentorId == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "id", "mentorshipId", "mentorId", "studentId", "content",
          "createdAt", "updatedAt"
        ])
        && request.resource.data.id == noteId
        && request.resource.data.mentorId == request.auth.uid
        && get(/databases/$(database)/documents/mentorships/$(request.resource.data.mentorshipId)).data.mentorId == request.auth.uid
        && get(/databases/$(database)/documents/mentorships/$(request.resource.data.mentorshipId)).data.studentId == request.resource.data.studentId
        && get(/databases/$(database)/documents/mentorships/$(request.resource.data.mentorshipId)).data.status == "active"
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 3
        && request.resource.data.content.size() <= 3000
        && safeUserText(request.resource.data.content, 3, 3000)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && resource.data.mentorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["content", "updatedAt"])
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 3
        && request.resource.data.content.size() <= 3000
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn()
        && (resource.data.mentorId == request.auth.uid || isAdmin());
    }

    match /mentorEvaluations/{evaluationId} {
      allow read: if signedIn()
        && (
          request.auth.uid in [resource.data.mentorId, resource.data.studentId]
          || isAdmin()
        );
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "id", "mentorshipId", "mentorId", "studentId", "progress",
          "summary", "nextSteps", "createdAt"
        ])
        && request.resource.data.id == evaluationId
        && request.resource.data.mentorId == request.auth.uid
        && get(/databases/$(database)/documents/mentorships/$(request.resource.data.mentorshipId)).data.mentorId == request.auth.uid
        && get(/databases/$(database)/documents/mentorships/$(request.resource.data.mentorshipId)).data.studentId == request.resource.data.studentId
        && get(/databases/$(database)/documents/mentorships/$(request.resource.data.mentorshipId)).data.status == "active"
        && request.resource.data.progress is int
        && request.resource.data.progress >= 1
        && request.resource.data.progress <= 5
        && request.resource.data.summary is string
        && request.resource.data.summary.size() >= 10
        && request.resource.data.summary.size() <= 2000
        && safeUserText(request.resource.data.summary, 10, 2000)
        && request.resource.data.nextSteps is string
        && request.resource.data.nextSteps.size() >= 5
        && request.resource.data.nextSteps.size() <= 1500
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /ideas/{ideaId} {
      function isOwner() {
        return signedIn() && resource.data.studentId == request.auth.uid;
      }

      function validOwnerCreate() {
        return signedIn()
          && roleIs("student")
          && request.resource.data.keys().hasOnly([
            "id", "studentId", "title", "slug", "shortDescription",
            "description", "problem", "solution", "targetAudience",
            "categoryId", "city", "stage", "supportNeeds", "visibility",
            "status", "adminNote", "rejectionReason", "revisionNote",
            "isFeatured", "viewCount", "supportCount", "likeCount",
            "commentCount", "coverImageUrl", "attachmentUrls",
            "prototypeUrl", "githubUrl", "websiteUrl", "publishedAt",
            "moderatedBy", "moderatedAt", "createdAt", "updatedAt"
          ])
          && request.resource.data.id == ideaId
          && request.resource.data.studentId == request.auth.uid
          && request.resource.data.status in ["draft", "pending"]
          && request.resource.data.isFeatured == false
          && request.resource.data.viewCount == 0
          && request.resource.data.likeCount == 0
          && request.resource.data.supportCount == 0
          && request.resource.data.commentCount == 0
          && request.resource.data.adminNote == ""
          && request.resource.data.rejectionReason == null
          && request.resource.data.revisionNote == null
          && request.resource.data.publishedAt == null
          && request.resource.data.moderatedBy == null
          && request.resource.data.moderatedAt == null
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && validIdeaContent();
      }

      function validIdeaContent() {
        return safeUserText(request.resource.data.title, 5, 100)
          && safeUserText(request.resource.data.shortDescription, 20, 240)
          && safeUserText(request.resource.data.description, 50, 5000)
          && safeUserText(request.resource.data.problem, 20, 2000)
          && safeUserText(request.resource.data.solution, 20, 2000)
          && safeUserText(request.resource.data.targetAudience, 5, 500)
          && request.resource.data.slug is string
          && request.resource.data.slug.size() >= 1
          && request.resource.data.slug.size() <= 140
          && request.resource.data.slug.matches("^[a-z0-9]+(?:-[a-z0-9]+)*$")
          && request.resource.data.categoryId in [
            "ai", "software", "education", "health", "agriculture",
            "environment", "social_enterprise", "game", "robotics",
            "tourism", "culture_art", "accessibility", "other"
          ]
          && validOptionalText(request.resource.data.city, 100)
          && request.resource.data.stage in [
            "dream", "idea", "research", "prototype", "team_building",
            "support_needed", "implemented", "startup", "completed"
          ]
          && request.resource.data.supportNeeds is list
          && request.resource.data.supportNeeds.size() >= 1
          && request.resource.data.supportNeeds.size() <= 6
          && request.resource.data.supportNeeds.hasOnly([
            "mentorship", "software", "design", "business_model", "education",
            "team_member", "equipment", "financial", "internship", "academic",
            "promotion", "company_visit"
          ])
          && request.resource.data.visibility in ["public", "anonymous", "private"]
          && validOptionalWebUrl(request.resource.data.coverImageUrl)
          && request.resource.data.attachmentUrls is list
          && request.resource.data.attachmentUrls.size() <= 5
          && validOptionalWebUrl(request.resource.data.prototypeUrl)
          && validOptionalWebUrl(request.resource.data.githubUrl)
          && validOptionalWebUrl(request.resource.data.websiteUrl);
      }

      function ownerEdit() {
        return isOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "title", "slug", "shortDescription", "description", "problem",
            "solution", "targetAudience", "categoryId", "city", "stage",
            "supportNeeds", "visibility", "coverImageUrl", "attachmentUrls",
            "prototypeUrl", "githubUrl", "websiteUrl", "rejectionReason",
            "revisionNote", "publishedAt", "moderatedBy", "moderatedAt",
            "updatedAt", "status"
          ])
          && request.resource.data.studentId == resource.data.studentId
          && (
            (resource.data.status == "draft" && request.resource.data.status in ["draft", "pending"])
            || (resource.data.status == "revision_requested"
              && request.resource.data.status in ["revision_requested", "pending"])
          )
          && request.resource.data.moderatedBy == null
          && request.resource.data.moderatedAt == null
          && request.resource.data.publishedAt == null
          && validIdeaContent();
      }

      function likeCountUpdate() {
        let likeId = ideaId + "__" + request.auth.uid;
        let likePath = /databases/$(database)/documents/likes/$(likeId);
        return signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likeCount"])
          && (
            (request.resource.data.likeCount == resource.data.likeCount + 1
              && existsAfter(likePath)
              && getAfter(likePath).data.ideaId == ideaId
              && getAfter(likePath).data.userId == request.auth.uid)
            || (request.resource.data.likeCount == resource.data.likeCount - 1
              && !existsAfter(likePath))
          )
          && request.resource.data.likeCount >= 0;
      }

      function sponsorSupportCountUpdate() {
        let supportId = request.resource.data.lastSponsorSupportId;
        let supportPath = /databases/$(database)/documents/sponsorSupports/$(supportId);
        return signedIn()
          && roleIs("sponsor")
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["supportCount", "lastSponsorSupportId"])
          && request.resource.data.supportCount == resource.data.supportCount + 1
          && existsAfter(supportPath)
          && getAfter(supportPath).data.ideaId == ideaId
          && getAfter(supportPath).data.sponsorId == request.auth.uid;
      }

      function adminEdit() {
        return isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "adminNote", "rejectionReason", "revisionNote",
            "publishedAt", "moderatedBy", "moderatedAt", "updatedAt"
          ])
          && request.resource.data.moderatedBy == request.auth.uid;
      }

      allow read: if resource.data.status == "approved"
        || isOwner()
        || isAdmin();
      allow create: if validOwnerCreate();
      allow update: if ownerEdit() || likeCountUpdate() || sponsorSupportCountUpdate() || adminEdit();
      allow delete: if isAdmin();
    }

    match /supportRequests/{requestId} {
      function idea() {
        return get(/databases/$(database)/documents/ideas/$(resource.data.ideaId));
      }

      function validSponsorCreate() {
        return currentUser().data.role == "sponsor"
          && request.resource.data.supporterId == request.auth.uid
          && request.resource.data.applicantRole == "sponsor"
          && request.resource.data.applicationType == "sponsorship"
          && requestId == request.auth.uid + "__" + request.resource.data.ideaId + "__sponsorship"
          && get(/databases/$(database)/documents/sponsorProfiles/$(request.auth.uid)).data.approvalStatus == "approved";
      }

      allow create: if signedIn()
        && currentUser().data.role in ["supporter", "mentor", "sponsor"]
        && request.resource.data.keys().hasOnly([
          "id", "ideaId", "supporterId", "supportTypes", "applicationType",
          "applicantRole", "message", "contactPreference",
          "contributionDetails", "sponsorshipOffer", "status", "adminNote",
          "createdAt", "updatedAt"
        ])
        && request.resource.data.id == requestId
        && request.resource.data.supporterId == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 20
        && request.resource.data.message.size() <= 1500
        && safeUserText(request.resource.data.message, 20, 1500)
        && request.resource.data.applicantRole == currentUser().data.role
        && (
          (currentUser().data.role == "supporter"
            && request.resource.data.applicationType == "support")
          || (currentUser().data.role == "mentor"
            && request.resource.data.applicationType == "mentorship")
          || validSponsorCreate()
        )
        && request.resource.data.contactPreference in ["platform", "email", "phone"]
        && validOptionalText(request.resource.data.contributionDetails, 1000)
        && (
          (
            request.resource.data.applicationType == "sponsorship"
            && request.resource.data.sponsorshipOffer is map
            && request.resource.data.sponsorshipOffer.keys().hasOnly([
              "estimatedBudget", "resources", "duration"
            ])
            && safeUserText(request.resource.data.sponsorshipOffer.estimatedBudget, 1, 120)
            && safeUserText(request.resource.data.sponsorshipOffer.resources, 10, 1500)
            && safeUserText(request.resource.data.sponsorshipOffer.duration, 2, 200)
          )
          || (
            request.resource.data.applicationType != "sponsorship"
            && request.resource.data.sponsorshipOffer == null
          )
        )
        && request.resource.data.supportTypes is list
        && request.resource.data.supportTypes.size() >= 1
        && request.resource.data.supportTypes.size() <= 4
        && request.resource.data.supportTypes.hasOnly([
          "mentorship", "software", "design", "business_model", "education",
          "team_member", "equipment", "financial", "internship", "academic",
          "promotion", "company_visit"
        ])
        && request.resource.data.adminNote == ""
        && !("reviewedBy" in request.resource.data)
        && !("reviewedAt" in request.resource.data)
        && !("approvedBy" in request.resource.data)
        && !("approvedAt" in request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && get(/databases/$(database)/documents/ideas/$(request.resource.data.ideaId)).data.status == "approved"
        && get(/databases/$(database)/documents/ideas/$(request.resource.data.ideaId)).data.studentId != request.auth.uid;

      allow read: if signedIn() && (
        resource.data.supporterId == request.auth.uid
        || idea().data.studentId == request.auth.uid
        || isAdmin()
      );

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "adminNote", "reviewedBy", "reviewedAt", "updatedAt"
        ])
        && request.resource.data.status in ["approved", "rejected"]
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;

      allow delete: if false;
    }

    match /comments/{commentId} {
      allow read: if resource.data.status == "active" || isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "id", "ideaId", "userId", "userName", "userRole", "content",
          "userAvatarUrl", "createdAt", "updatedAt", "status"
        ])
        && request.resource.data.id == commentId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userRole == currentUser().data.role
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 2
        && request.resource.data.content.size() <= 1000
        && safeUserText(request.resource.data.content, 2, 1000)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          (
            !currentUser().data.keys().hasAny(["avatarUrl"])
            && request.resource.data.userAvatarUrl == null
          )
          || (
            currentUser().data.keys().hasAny(["avatarUrl"])
            && request.resource.data.userAvatarUrl == currentUser().data.avatarUrl
          )
        )
        && request.resource.data.status == "active"
        && get(/databases/$(database)/documents/ideas/$(request.resource.data.ideaId)).data.status == "approved";
      allow update: if signedIn() && (
        (
          resource.data.userId == request.auth.uid
          && resource.data.status == "active"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["content", "updatedAt"])
          && request.resource.data.content is string
          && request.resource.data.content.size() >= 2
          && request.resource.data.content.size() <= 1000
          && safeUserText(request.resource.data.content, 2, 1000)
          && request.resource.data.updatedAt == request.time
        )
        || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "updatedAt"])
          && request.resource.data.status == "hidden"
          && request.resource.data.updatedAt == request.time
        )
      );
      allow delete: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /likes/{likeId} {
      allow list: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "id", "ideaId", "userId", "createdAt"
        ])
        && request.resource.data.id == likeId
        && request.resource.data.userId == request.auth.uid
        && likeId == request.resource.data.ideaId + "__" + request.auth.uid
        && get(/databases/$(database)/documents/ideas/$(request.resource.data.ideaId)).data.status == "approved";
      allow update: if false;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /favorites/{favoriteId} {
      allow list: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "id", "ideaId", "userId", "createdAt"
        ])
        && request.resource.data.id == favoriteId
        && request.resource.data.userId == request.auth.uid
        && favoriteId == request.resource.data.ideaId + "__" + request.auth.uid
        && get(/databases/$(database)/documents/ideas/$(request.resource.data.ideaId)).data.status == "approved";
      allow update: if false;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      function validNotificationSource() {
        let type = request.resource.data.type;
        let sourceId = request.resource.data.sourceId;
        let actorId = request.resource.data.actorId;
        let recipientId = request.resource.data.userId;
        return (
          (type == "idea_liked"
            && get(/databases/$(database)/documents/likes/$(sourceId)).data.userId == actorId
            && get(/databases/$(database)/documents/ideas/$(get(/databases/$(database)/documents/likes/$(sourceId)).data.ideaId)).data.studentId == recipientId)
          || (type == "idea_comment"
            && get(/databases/$(database)/documents/comments/$(sourceId)).data.userId == actorId
            && get(/databases/$(database)/documents/ideas/$(get(/databases/$(database)/documents/comments/$(sourceId)).data.ideaId)).data.studentId == recipientId)
          || (type == "support_request_received"
            && get(/databases/$(database)/documents/supportRequests/$(sourceId)).data.supporterId == actorId
            && get(/databases/$(database)/documents/ideas/$(get(/databases/$(database)/documents/supportRequests/$(sourceId)).data.ideaId)).data.studentId == recipientId)
          || (type in ["idea_approved", "idea_rejected"]
            && isAdmin()
            && get(/databases/$(database)/documents/ideas/$(sourceId)).data.studentId == recipientId)
          || (type in ["support_approved", "support_rejected", "support_request_approved", "support_request_rejected"]
            && isAdmin()
            && get(/databases/$(database)/documents/supportRequests/$(sourceId)).data.supporterId == recipientId)
          || (type in ["sponsorship_offer_approved", "sponsorship_offer_rejected"]
            && isAdmin()
            && get(/databases/$(database)/documents/ideas/$(get(/databases/$(database)/documents/supportRequests/$(sourceId)).data.ideaId)).data.studentId == recipientId)
          || (type in ["new_message", "chat_message"]
            && actorId in get(/databases/$(database)/documents/conversations/$(sourceId)).data.participantIds
            && recipientId in get(/databases/$(database)/documents/conversations/$(sourceId)).data.participantIds
            && actorId != recipientId)
          || (type == "meeting_created"
            && get(/databases/$(database)/documents/meetings/$(sourceId)).data.organizerId == actorId
            && recipientId in get(/databases/$(database)/documents/meetings/$(sourceId)).data.participantIds
            && actorId != recipientId)
          || (type in ["meeting_updated", "meeting_cancelled"]
            && actorId in get(/databases/$(database)/documents/meetings/$(sourceId)).data.participantIds
            && recipientId in get(/databases/$(database)/documents/meetings/$(sourceId)).data.participantIds
            && actorId != recipientId)
          || (type == "new_idea"
            && get(/databases/$(database)/documents/ideas/$(sourceId)).data.studentId == actorId
            && get(/databases/$(database)/documents/users/$(recipientId)).data.role in ["admin", "superadmin"])
          || (type == "new_support_request"
            && get(/databases/$(database)/documents/supportRequests/$(sourceId)).data.supporterId == actorId
            && get(/databases/$(database)/documents/users/$(recipientId)).data.role in ["admin", "superadmin"])
          || (type == "admin_activity"
            && get(/databases/$(database)/documents/sponsorProfiles/$(sourceId)).data.sponsorId == actorId
            && get(/databases/$(database)/documents/users/$(recipientId)).data.role in ["admin", "superadmin"])
          || (type == "sponsor_support_received"
            && get(/databases/$(database)/documents/sponsorSupports/$(sourceId)).data.sponsorId == actorId
            && get(/databases/$(database)/documents/sponsorSupports/$(sourceId)).data.ideaOwnerId == recipientId)
          || (type == "sponsor_approved"
            && isAdmin()
            && get(/databases/$(database)/documents/sponsorProfiles/$(sourceId)).data.sponsorId == recipientId)
        );
      }

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "id", "userId", "actorId", "sourceId", "title", "message", "type",
          "link", "read", "createdAt"
        ])
        && request.resource.data.id == notificationId
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.read == false
        && (request.resource.data.link == null || request.resource.data.link is string)
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && validNotificationSource();
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"])
        && request.resource.data.read == true;
      allow delete: if false;
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "id", "type", "title", "description", "pagePath", "userId",
          "userName", "userEmail", "status", "createdAt", "updatedAt"
        ])
        && request.resource.data.id == feedbackId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.userName
          == currentUser().data.name + " " + currentUser().data.surname
        && request.resource.data.type in ["bug", "suggestion", "satisfaction"]
        && request.resource.data.status == "open"
        && safeUserText(request.resource.data.title, 5, 120)
        && safeUserText(request.resource.data.description, 15, 3000)
        && request.resource.data.pagePath is string
        && request.resource.data.pagePath.size() >= 1
        && request.resource.data.pagePath.size() <= 500
        && request.resource.data.pagePath.matches("^/([^/].*)?$")
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "updatedAt"])
        && request.resource.data.status in ["open", "reviewing", "resolved"]
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /dailyActiveUsers/{activityId} {
      allow read: if isAdmin();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly([
          "id", "userId", "date", "lastActiveAt"
        ])
        && request.resource.data.id == activityId
        && request.resource.data.userId == request.auth.uid
        && activityId == request.resource.data.date + "__" + request.auth.uid
        && request.resource.data.date is string
        && request.resource.data.date.matches("^\\d{4}-\\d{2}-\\d{2}$")
        && request.resource.data.lastActiveAt == request.time;
      allow delete: if false;
    }

    match /userActivity/{userId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == userId);
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["userId", "lastActiveAt"])
        && request.resource.data.userId == userId
        && request.resource.data.lastActiveAt == request.time;
      allow delete: if false;
    }

    match /sponsorProfiles/{sponsorId} {
      function validProfileFields() {
        return request.resource.data.institutionName is string
          && request.resource.data.institutionName.size() >= 2
          && request.resource.data.institutionName.size() <= 120
          && request.resource.data.description is string
          && request.resource.data.description.size() >= 20
          && request.resource.data.description.size() <= 1500
          && request.resource.data.city is string
          && request.resource.data.supportAreas is list
          && request.resource.data.supportAreas.size() >= 1
          && request.resource.data.supportAreas.size() <= 12;
      }
      allow read: if resource.data.approvalStatus == "approved"
        || (signedIn() && request.auth.uid == sponsorId)
        || isAdmin();
      allow create: if signedIn()
        && request.auth.uid == sponsorId
        && getAfter(/databases/$(database)/documents/users/$(sponsorId)).data.role == "sponsor"
        && request.resource.data.keys().hasOnly([
          "sponsorId", "institutionName", "organizationName",
          "organizationType", "logoUrl", "description", "website", "city",
          "supportAreas", "approvalStatus", "reviewedBy",
          "reviewedAt", "createdAt", "updatedAt"
        ])
        && request.resource.data.sponsorId == sponsorId
        && request.resource.data.approvalStatus == "pending"
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validProfileFields();
      allow update: if signedIn() && (
        (
          request.auth.uid == sponsorId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "institutionName", "logoUrl", "description", "website", "city",
            "organizationName", "organizationType", "supportAreas",
            "approvalStatus", "reviewedBy", "reviewedAt", "updatedAt"
          ])
          && request.resource.data.approvalStatus == "pending"
          && request.resource.data.reviewedBy == null
          && request.resource.data.reviewedAt == null
          && request.resource.data.updatedAt == request.time
          && validProfileFields()
        )
        || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              "approvalStatus", "reviewedBy", "reviewedAt", "updatedAt"
            ])
          && request.resource.data.approvalStatus in ["approved", "rejected"]
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedAt == request.time
          && request.resource.data.updatedAt == request.time
        )
        || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "isApproved", "approvalStatus", "updatedAt"])
          && request.resource.data.approvalStatus in ["pending", "approved", "rejected"]
          && !("status" in request.resource.data)
          && !("isApproved" in request.resource.data)
          && request.resource.data.updatedAt == request.time
        )
      );
      allow delete: if isAdmin();
    }

    match /sponsorSupports/{supportId} {
      allow read: if signedIn() && (
        resource.data.sponsorId == request.auth.uid
        || resource.data.ideaOwnerId == request.auth.uid
        || isAdmin()
      );
      allow create: if signedIn()
        && roleIs("sponsor")
        && request.resource.data.keys().hasOnly([
          "id", "sponsorId", "sponsorName", "ideaId", "ideaOwnerId",
          "ideaTitle", "ideaSlug", "message", "createdAt"
        ])
        && request.resource.data.id == supportId
        && request.resource.data.sponsorId == request.auth.uid
        && supportId == request.auth.uid + "__" + request.resource.data.ideaId
        && get(/databases/$(database)/documents/sponsorProfiles/$(request.auth.uid)).data.approvalStatus == "approved"
        && get(/databases/$(database)/documents/ideas/$(request.resource.data.ideaId)).data.status == "approved"
        && get(/databases/$(database)/documents/ideas/$(request.resource.data.ideaId)).data.studentId == request.resource.data.ideaOwnerId
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 1000
        && safeUserText(request.resource.data.message, 10, 1000)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /conversations/{conversationId} {
      function participant() {
        return signedIn() && request.auth.uid in resource.data.participantIds;
      }

      allow read: if participant() || isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "id", "participantIds", "participantRoles", "ideaId", "ideaTitle",
          "supportRequestId", "mentorshipId", "type", "ownerId", "supporterId",
          "lastMessage", "lastMessageAt", "unreadCounts", "createdAt", "updatedAt"
        ])
        && request.resource.data.id == conversationId
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantRoles is map
        && request.resource.data.participantRoles.keys().hasOnly(request.resource.data.participantIds)
        && request.resource.data.participantRoles.keys().hasAll(request.resource.data.participantIds)
        && request.resource.data.ownerId in request.resource.data.participantIds
        && request.resource.data.supporterId in request.resource.data.participantIds
        && request.resource.data.lastMessage == null
        && request.resource.data.lastMessageAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          (isAdmin()
            && conversationId == "support__" + request.resource.data.supportRequestId
            && request.resource.data.mentorshipId == null
            && request.resource.data.type in ["support", "mentorship", "sponsorship"]
            && getAfter(/databases/$(database)/documents/supportRequests/$(request.resource.data.supportRequestId)).data.status == "approved"
            && request.resource.data.supporterId == getAfter(/databases/$(database)/documents/supportRequests/$(request.resource.data.supportRequestId)).data.supporterId
            && request.resource.data.ownerId == getAfter(/databases/$(database)/documents/ideas/$(request.resource.data.ideaId)).data.studentId
            && request.resource.data.participantIds.hasAll([request.resource.data.ownerId, request.resource.data.supporterId])
            && request.resource.data.participantRoles.get(request.resource.data.ownerId, "") == "student"
            && request.resource.data.participantRoles.get(request.resource.data.supporterId, "") == getAfter(/databases/$(database)/documents/supportRequests/$(request.resource.data.supportRequestId)).data.applicantRole)
          || ((roleIs("mentor") || isAdmin())
            && conversationId == "mentorship__" + request.resource.data.mentorshipId
            && request.resource.data.supportRequestId == request.resource.data.mentorshipId
            && request.resource.data.type == "mentorship"
            && getAfter(/databases/$(database)/documents/mentorships/$(request.resource.data.mentorshipId)).data.status == "active"
            && request.resource.data.ownerId == getAfter(/databases/$(database)/documents/mentorships/$(request.resource.data.mentorshipId)).data.studentId
            && request.resource.data.supporterId == getAfter(/databases/$(database)/documents/mentorships/$(request.resource.data.mentorshipId)).data.mentorId
            && request.resource.data.participantRoles.get(request.resource.data.ownerId, "") == "student"
            && request.resource.data.participantRoles.get(request.resource.data.supporterId, "") == "mentor")
        );
      allow update: if participant()
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.participantRoles == resource.data.participantRoles
        && request.resource.data.ideaId == resource.data.ideaId
        && request.resource.data.supportRequestId == resource.data.supportRequestId
        && request.resource.data.mentorshipId == resource.data.mentorshipId
        && request.resource.data.type == resource.data.type
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "lastMessage", "lastMessageAt", "updatedAt", "unreadCounts"
        ]);
      allow delete: if false;

      match /messages/{messageId} {
        function conversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId));
        }

        allow read: if signedIn()
          && (request.auth.uid in conversation().data.participantIds || isAdmin());
        allow create: if signedIn()
          && !isAdmin()
          && request.resource.data.keys().hasOnly([
            "id", "senderId", "text", "createdAt", "readBy", "status"
          ])
          && request.auth.uid in conversation().data.participantIds
          && request.resource.data.id == messageId
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.readBy == [request.auth.uid]
          && request.resource.data.status == "sent"
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && safeUserText(request.resource.data.text, 1, 2000);
        allow update: if signedIn()
          && request.auth.uid in conversation().data.participantIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readBy"])
          && request.resource.data.readBy.hasAll(resource.data.readBy)
          && request.resource.data.readBy.hasAll([request.auth.uid]);
        allow delete: if false;
      }
    }

    match /meetings/{meetingId} {
      function linkedConversation() {
        return get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId));
      }

      allow read: if signedIn()
        && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if signedIn()
        && !isAdmin()
        && request.resource.data.keys().hasOnly([
          "conversationId", "ideaId", "title", "description", "participantIds",
          "organizerId", "startAt", "endAt", "location", "meetingType",
          "meetingProvider", "meetingRoomId", "meetingLink", "meetingUrl", "status",
          "createdAt", "updatedAt"
        ])
        && exists(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId))
        && request.auth.uid in linkedConversation().data.participantIds
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds.hasOnly(linkedConversation().data.participantIds)
        && request.resource.data.participantIds.hasAll(linkedConversation().data.participantIds)
        && request.resource.data.ideaId == linkedConversation().data.ideaId
        && request.resource.data.organizerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.startAt is timestamp
        && request.resource.data.endAt is timestamp
        && request.resource.data.endAt > request.resource.data.startAt
        && (request.resource.data.location == null || request.resource.data.location is string)
        && request.resource.data.meetingType in ["online", "phone", "face_to_face"]
        && request.resource.data.meetingUrl == null
        && (
          (request.resource.data.meetingType == "online"
            && request.resource.data.meetingProvider == "jitsi"
            && request.resource.data.meetingRoomId is string
            && request.resource.data.meetingRoomId.size() >= 40
            && request.resource.data.meetingLink == "https://meet.jit.si/" + request.resource.data.meetingRoomId)
          || (request.resource.data.meetingType != "online"
            && request.resource.data.meetingProvider == null
            && request.resource.data.meetingRoomId == null
            && request.resource.data.meetingLink == null)
        )
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && (request.auth.uid in resource.data.participantIds || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
        && (
          (resource.data.status in ["pending", "scheduled"]
            && request.resource.data.status in ["accepted", "rejected", "cancelled"])
          || (resource.data.status == "accepted"
            && request.resource.data.status in ["completed", "cancelled"])
        )
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && (request.auth.uid == resource.data.organizerId || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "meetingType", "meetingProvider", "meetingRoomId", "meetingLink", "updatedAt"
        ])
        && !("meetingLink" in resource.data)
        && (!("meetingType" in resource.data) || resource.data.meetingType == "online")
        && request.resource.data.meetingType == "online"
        && request.resource.data.meetingProvider == "jitsi"
        && request.resource.data.meetingRoomId is string
        && request.resource.data.meetingRoomId.size() >= 40
        && request.resource.data.meetingLink == "https://meet.jit.si/" + request.resource.data.meetingRoomId
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
